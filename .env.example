# Application
DERE_ENVIRONMENT=development
DERE_LOG_LEVEL=INFO
DERE_MODEL_VERSION=dere-v1

# PostgreSQL connection. Supply this only through a local .env or secret manager.
# DERE_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>

# Dedicated, disposable PostgreSQL database used by integration tests.
# DERE_TEST_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
