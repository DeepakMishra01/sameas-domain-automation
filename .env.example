# Copy this file to ".env" and fill in your values.
# ".env" is gitignored, so your API key stays private and is never committed.
# Once set, you never need to `export` these again — the scripts read .env.

# Database (local docker-compose Postgres)
DERE_DATABASE_URL=postgresql+psycopg://dere:change-me@localhost:5432/dere

# LLM provider for the AI verification step: ollama | gemini | nvidia | openai
DERE_LLM_PROVIDER=nvidia
DERE_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# API key for the chosen provider (only the one you use is needed)
DERE_NVIDIA_API_KEY=nvapi-your-key-here
# DERE_GEMINI_API_KEY=your-gemini-key

# Optional: Serper (Google Search) fallback for low-confidence AI verdicts.
# When set, pairs the AI is unsure about (confidence below the threshold) get a
# Google search whose results are fed back to the AI for a better final call.
# DERE_SERPER_API_KEY=your-serper-key
# DERE_SERP_MIN_CONFIDENCE=0.5
# How many search queries per pair: 1 = relationship only (cheaper), 2 = also an
# identity/knowledge-graph query (better recall, ~2x search cost). Default 2.
# DERE_SERP_QUERIES=2
# DERE_SERP_ALL=1 runs a Serper web QC on EVERY pair (a third layer that
# cross-checks all outputs), not just low-confidence ones. Agreement confirms the
# verdict. On disagreement, solid rules are PROTECTED: a proven redirect is kept;
# any other documented deterministic rule -> REVIEW_REQUIRED (QC cannot override
# the SOP); only an UNCERTAIN verdict is corrected by a confident QC verdict
# (>= DERE_SERP_QC_CORRECT_MIN), else -> REVIEW. Higher cost/time.
# DERE_SERP_ALL=0
# DERE_SERP_QC_CORRECT_MIN=0.8
